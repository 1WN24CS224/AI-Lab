board = [" "] * 9
player = "X"
def display():
    print(board[0], "|", board[1], "|", board[2])
    
    print(board[3], "|", board[4], "|", board[5])
    
    print(board[6], "|", board[7], "|", board[8])
def winner():
    combinations = [
        (0,1,2), (3,4,5), (6,7,8),
        (0,3,6), (1,4,7), (2,5,8),
        (0,4,8), (2,4,6)]

    for a, b, c in combinations:
        if board[a] == board[b] == board[c] != " ":
            return True

    return False
for i in range(9):
    display()
    print("Player", player)
    pos = int(input("Enter position (1-9): ")) - 1

    while board[pos] != " ":
        print("Position occupied, Try again.")
        pos = int(input("Enter position (1-9): ")) - 1

    board[pos] = player

    if winner():
        display()
        print("Player", player, "wins!")
        break

    if i == 8:
        display()
        print("Game is a draw")

    if player == "X":
        player = "O"
    else:
        player = "X"
